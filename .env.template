# AIKiosQ Environment Template
# Copy this file to .env.local and fill in your values

# --- Amazon Bedrock Credentials (Client/Server) ---
VITE_AWS_ACCESS_KEY_ID=your_access_key_id
VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key
VITE_AWS_REGION=us-east-1

# --- Deployment Configuration (deploy.py) ---
AWS_ACCOUNT_ID=your_aws_account_id
AWS_APP_RUNNER_SERVICE_ARN=your_app_runner_service_arn
ECR_REPOSITORY_NAME=aikiosq-app-runner
# Optional: Keep your old key if you are using it for something else
NOVA_API_KEY=your_optional_api_key
